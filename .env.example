# Postgres connection string for the app (and for `npm run db:migrate`).
DATABASE_URL=
# Better Auth signing secret: a long random string (e.g. `openssl rand -hex 32`).
BETTER_AUTH_SECRET=
# Public base URL of the app, e.g. http://localhost:3000 locally.
BETTER_AUTH_URL=
# Resend API key. Required in production whenever emails are sent; unset locally logs them instead.
RESEND_API_KEY=
# Optional sender, e.g. "Clasync <no-reply@your-domain>"; defaults to Resend's onboarding address.
EMAIL_FROM=
# Outside Vercel production, only these addresses (comma-separated) receive email; others are logged and skipped.
# On a Vercel preview with no list, no email is sent at all. Ignored in production.
EMAIL_ALLOWLIST=
# Email verification is ON unless this is "false". Set false until Resend's domain is verified.
AUTH_REQUIRE_EMAIL_VERIFICATION=
# Shared secret for the reminders cron route (/api/cron/reminders). Vercel Cron sends it as a Bearer token when set in Vercel; for manual POST runs send it yourself. The route answers 503 while unset.
CRON_SECRET=
# Throwaway database for `npm run e2e` (migrate it first); defaults to postgres://postgres@127.0.0.1:54329/clasync_e2e.
E2E_DATABASE_URL=
# IANA time zone in which class sessions are scheduled; defaults to Africa/Douala.
APP_TIME_ZONE=
# File storage: "blob" (Vercel Blob, private store) or "local" (disk, for development and e2e).
# Defaults to local outside production when BLOB_READ_WRITE_TOKEN is unset, blob otherwise.
STORAGE_DRIVER=
# Vercel Blob read-write token (set automatically on Vercel once a private Blob store is connected).
BLOB_READ_WRITE_TOKEN=
# Directory for the local driver; defaults to .uploads/ in the project folder.
LOCAL_UPLOAD_DIR=
# AI mark suggestions: an AI Gateway "provider/model" string; defaults to openai/gpt-5-mini.
# "fake" uses a deterministic stand-in (for e2e and local work; refused on Vercel production).
AI_MARKING_MODEL=
# AI Gateway API key for local runs. On Vercel the project's OIDC token is used instead. Without either, suggestions are off.
AI_GATEWAY_API_KEY=
