# Postgres connection string for the app (and for `npm run db:migrate`).
DATABASE_URL=
# TLS to Postgres: "no-verify" encrypts without checking the certificate (Heroku Postgres; the default on
# Heroku), "off" leaves it to the URL's sslmode. Unset elsewhere means plain connections unless the URL says otherwise.
DATABASE_SSL=
# Where this copy runs, on hosts that don't say it themselves (Heroku): "production" or "staging".
# Vercel's VERCEL_ENV is read when this is unset.
APP_ENV=
# Background jobs: "pgboss" (jobs in Postgres, worked by the web process: Heroku), "vercel" (Vercel Queues)
# or "memory" (in-process timers: local work). Defaults: vercel on Vercel, pgboss on Heroku, memory elsewhere.
QUEUE_DRIVER=
# Better Auth signing secret: a long random string (e.g. `openssl rand -hex 32`).
BETTER_AUTH_SECRET=
# Public base URL of the app, e.g. http://localhost:3000 locally.
BETTER_AUTH_URL=
# Resend API key. Required in production whenever emails are sent; unset locally logs them instead.
RESEND_API_KEY=
# Optional sender, e.g. "Clasync <no-reply@your-domain>"; defaults to Resend's onboarding address.
EMAIL_FROM=
# Amazon SES region (e.g. eu-west-3) for admin announcements; credentials come from the standard AWS variables. In production an announcement can't be sent without it; elsewhere it is logged instead.
SES_REGION=
# Outside Vercel production, only these addresses (comma-separated) receive email; others are logged and skipped.
# "*" lets everyone through (staging uses it). On a Vercel preview with no list, no email is sent at all. Ignored in production.
EMAIL_ALLOWLIST=
# Email verification is ON unless this is "false". Set false until Resend's domain is verified.
AUTH_REQUIRE_EMAIL_VERIFICATION=
# Shared secret for the reminders cron route (/api/cron/reminders). Vercel Cron sends it as a Bearer token when set in Vercel; for manual POST runs send it yourself. The route answers 503 while unset.
CRON_SECRET=
# Throwaway database for `npm run e2e` (migrate it first); defaults to postgres://postgres@127.0.0.1:54329/clasync_e2e.
E2E_DATABASE_URL=
# IANA time zone in which class sessions are scheduled; defaults to Africa/Douala.
APP_TIME_ZONE=
# File storage: "s3" (Amazon S3, private bucket: Heroku), "blob" (Vercel Blob, private store) or "local"
# (disk, for development and e2e).
# Defaults to local outside production when BLOB_READ_WRITE_TOKEN is unset, blob otherwise.
STORAGE_DRIVER=
# Vercel Blob read-write token (set automatically on Vercel once a private Blob store is connected).
BLOB_READ_WRITE_TOKEN=
# Directory for the local driver; defaults to .uploads/ in the project folder.
LOCAL_UPLOAD_DIR=
# S3 driver: the private bucket and its region (default eu-west-3). The bucket needs a CORS rule allowing
# PUT from the site (scripts/aws/setup.sh sets it up).
S3_BUCKET=
S3_REGION=
# AWS access key of the app's IAM user (Heroku): S3 files and Bedrock. Not used on Vercel, which signs in
# through OIDC (AI_AWS_ROLE_ARN).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Test short-answer mark suggestions: a Bedrock model or inference-profile id; defaults to
# eu.anthropic.claude-haiku-4-5-20251001-v1:0. An old AI Gateway "provider/model" value is ignored.
# "fake" uses a deterministic stand-in (for e2e and local work; refused in production).
AI_MARKING_MODEL=
# Assignment and test mark suggestions (Claude on Amazon Bedrock): on Vercel, the IAM role Vercel's OIDC token is exchanged for. On Heroku leave it unset and set AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY instead. Neither means the feature is off.
AI_AWS_ROLE_ARN=
# Bedrock region; defaults to eu-west-3.
AI_AWS_REGION=
# Bedrock model or inference-profile id; defaults to eu.anthropic.claude-haiku-4-5-20251001-v1:0. "fake" is a stand-in (refused on Vercel production).
AI_ASSIGNMENT_MODEL=
# Maximum AI calls per UTC month across all lecturers; defaults to 3000.
AI_MONTHLY_CAP=
# Admins (the /admin area): comma-separated emails, case-insensitive. The account also needs a verified email, whatever AUTH_REQUIRE_EMAIL_VERIFICATION says. Unset means no admins. Set per Vercel environment (Preview admins are staging accounts).
ADMIN_EMAILS=
# Reply-to on every email, and the contact a suspended account sees at sign-in. Defaults to support@clasync.online.
SUPPORT_EMAIL=
# "Continue with Google": an OAuth client (Google Cloud → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Its authorized redirect URI is <BETTER_AUTH_URL>/api/auth/callback/google. Both unset hides the Google buttons. Use one client per environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sentry error tracking: the project's DSN (Sentry → Project settings → Client keys). Unset turns it off.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: upload source maps at build time so Sentry shows readable stack traces.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Web push (VAPID). Generate a pair with `npx web-push generate-vapid-keys`; use separate pairs for staging and production.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services; defaults to mailto:support@clasync.online.
VAPID_SUBJECT=

# WhatsApp alerts through AWS End User Messaging Social. These four are required, or WhatsApp stays off.
# Sending signs in with AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY above (the IAM user needs
# social-messaging:SendWhatsAppMessage on the phone number). Always off when APP_ENV=staging.
# WHATSAPP_AWS_REGION=eu-west-1
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_DISPLAY_NUMBER=
# WHATSAPP_SNS_TOPIC_ARN=
# Vercel only: an IAM role Vercel's OIDC token is exchanged for, instead of the access key.
# WHATSAPP_AWS_ROLE_ARN=
# Optional: messages per month before sending stops (default 2000).
# WHATSAPP_MONTHLY_CAP=2000
# Optional rollout list: comma-separated E.164 numbers; when non-empty (in any environment), only these receive WhatsApp.
# Set the WHATSAPP_* variables on the production app only.
# WHATSAPP_ALLOWLIST=
